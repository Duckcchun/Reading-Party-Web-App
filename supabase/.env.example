# Supabase Edge Function 환경변수
# supabase secrets set 명령으로 설정하거나 Supabase Dashboard에서 설정

SUPABASE_URL=https://ellwyzmsqbocrnsxwucz.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Spotify (곡 검색 서버사이드용)
